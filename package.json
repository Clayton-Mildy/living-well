{
  "name": "living-well",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"pnpm --filter @cp/server dev\" \"pnpm --filter @cp/web dev\"",
    "dev:host": "concurrently -k -n server,web -c yellow,cyan \"pnpm --filter @cp/server dev\" \"pnpm --filter @cp/web dev --host\"",
    "build": "pnpm --filter @cp/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "pnpm -r exec tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "db:setup": "pnpm --filter @cp/server db:setup",
    "db:reset": "pnpm --filter @cp/server db:reset",
    "convert": "node scripts/dc2jsx.mjs",
    "start": "pnpm --filter @cp/web build && pnpm --filter @cp/server start",
    "tunnel": "cloudflared tunnel --no-autoupdate --url http://localhost:8787",
    "demo": "pnpm --filter @cp/web build && concurrently -k -n app,tunnel -c green,magenta \"pnpm --filter @cp/server start\" \"cloudflared tunnel --no-autoupdate --url http://localhost:8787\"",
    "dev:tunnel": "concurrently -k -n server,web,tunnel -c yellow,cyan,magenta \"pnpm --filter @cp/server dev\" \"VITE_HMR_CLIENT_PORT=443 pnpm --filter @cp/web dev\" \"cloudflared tunnel --no-autoupdate --url http://localhost:5173\"",
    "test:e2e": "playwright test",
    "e2e:env": "bash scripts/e2e-env.sh",
    "review": "scripts/review.sh",
    "e2e:all": "scripts/e2e-all.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "htmlparser2": "^12.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
